# API base URL for the mobile app (include /api/v1)
#
# iOS simulator / web:  http://localhost:5000/api/v1
# Android emulator:     http://10.0.2.2:5000/api/v1  (auto-rewritten from localhost)
# Physical device:      http://YOUR_PC_LAN_IP:5000/api/v1
#
# Restart Expo after changing this value: npx expo start -c
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
